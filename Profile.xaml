<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E230145.Profile"
             Title="Perfil">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Border x:Name="borderPerfil" StrokeShape="RoundRectangle 20"
                StrokeThickness="2" Stroke="WhiteSmoke" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="lblNombre" FontAttributes="Bold"
                       FontSize="24" Text="Cargando perfil..." TextColor="Black" />

                <HorizontalStackLayout Spacing="10">
                    <Label FontAttributes="Italic,Bold" FontSize="14"
                           Text="Disponibilidad para trabajar"
                           VerticalOptions="Center" />
                    <Switch x:Name="switchDisponibilidad" IsToggled="True"
                            Toggled="SwitchDisponibilidad_Toggled" />
                </HorizontalStackLayout>

                <Label Text="Años de experiencia:" FontSize="18" />
                <Slider x:Name="sliderExperiencia" Minimum="0" Maximum="15"
                        ValueChanged="SliderExperiencia_ValueChanged" />
                <Label x:Name="lblExperiencia" FontSize="18"
                       Text="0 años de experiencia" />
                <Label x:Name="lblNivel" FontSize="18" FontAttributes="Bold" />

                <Button x:Name="btnGuardar" Text="Enviar cambios a la API"
                        Clicked="BtnGuardar_Clicked" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Cerrar sesión" Clicked="BtnCerrarSesion_Clicked"
                BackgroundColor="Red" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>
